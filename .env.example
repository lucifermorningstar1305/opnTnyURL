# ============================================================
# Application
# ============================================================


BACKEND_PORT=8080
FRONTEND_PORT=8501

API_BASE_URL=http://backend:8080
PUBLIC_BASE_URL=https://example.com

APP_DOMAIN=example.com
API_DOMAIN=api.example.com

# This is the exact prefix used when generating short IDs.
# Examples could be A1, X, m3, etc.
# No prefix is assumed by compose.yml.
MACHINE_ID=A1



# ============================================================
# Docker images
# ============================================================

APP_VERSION=latest


# ============================================================
# Traefik / TLS
# ============================================================

ACME_EMAIL=your-email@example.com


# ============================================================
# PostgreSQL
# ============================================================

ASYNC_POSTGRES_URL=postgresql+asyncpg://opntnyurl_user:<change-me>@postgres:5432/opntnyurl_db
POSTGRES_URL=postgresql+psycopg://opntnyurl_user:<change-me>@postgres:5432/opntnyurl_db



# ============================================================
# Valkey
# ============================================================

# The regular valkey/valkey image does NOT provide BF.*
# commands. Use a Bloom-capable Valkey image.
VALKEY_IMAGE=valkey/valkey-bundle:latest

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=change-me

VALKEY_BLOOM_FILTER_NAME=opn_tny_url_bloom
